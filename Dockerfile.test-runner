# ==============================================================================
# Online Food Ordering System - Standalone Test Runner Docker Image
# ==============================================================================
FROM eclipse-temurin:17-jdk-alpine AS test-runner

# Install utility tools
RUN apk add --no-cache bash curl git

WORKDIR /workspace

# Step 1: Cache Maven wrapper and POM files for fast layer caching
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY config-server/pom.xml config-server/pom.xml
COPY discovery-service/pom.xml discovery-service/pom.xml
COPY gateway-service/pom.xml gateway-service/pom.xml
COPY user-service/pom.xml user-service/pom.xml
COPY restaurant-service/pom.xml restaurant-service/pom.xml
COPY order-service/pom.xml order-service/pom.xml
COPY payment-service/pom.xml payment-service/pom.xml
COPY notification-service/pom.xml notification-service/pom.xml

RUN chmod +x ./mvnw

# Resolve all dependencies in offline mode (cached layer)
RUN ./mvnw dependency:go-offline -B || true

# Step 2: Copy full source code
COPY config-server/src config-server/src
COPY discovery-service/src discovery-service/src
COPY gateway-service/src gateway-service/src
COPY user-service/src user-service/src
COPY restaurant-service/src restaurant-service/src
COPY order-service/src order-service/src
COPY payment-service/src payment-service/src
COPY notification-service/src notification-service/src
COPY scripts/docker-test-runner.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

# Environment variables
ENV TARGET_SERVICE="ALL"
ENV SPRING_PROFILES_ACTIVE="test"

VOLUME [ "/workspace/target/test-reports" ]

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
