{
  "name": "food-delivery-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Food Delivery Platform - Unified Frontend Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:user": "npm run dev --workspace=@foodapp/frontend-user",
    "dev:restaurant": "npm run dev --workspace=@foodapp/frontend-restaurant",
    "dev:delivery": "npm run dev --workspace=@foodapp/frontend-delivery",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
